{
  "name": "@antadmin/framework-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An admin framework (Nuxt 4 + Ant Design Vue) — monorepo core",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:release": "node --test tests/release-workflow.test.mjs",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@antadmin/eslint-config": "workspace:*",
    "@antadmin/tsconfig": "workspace:*",
    "eslint": "^10.10.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
