{
  "name": "@antadmin/mcp",
  "version": "1.4.0",
  "description": "MCP server nội bộ AntAdmin — phơi tri thức framework (component C*, design token, docs, package) cho AI của team sản phẩm",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "antadmin-mcp": "./bin/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "data",
    "bin"
  ],
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "build": "tsx scripts/generate.ts && unbuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "clean": "rm -rf dist data .turbo coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@antadmin/eslint-config": "workspace:*",
    "@antadmin/theme": "workspace:*",
    "@antadmin/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "unbuild": "^3.0.1",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daothanh/antadmin.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
