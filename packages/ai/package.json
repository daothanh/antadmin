{
  "name": "@antadmin/ai",
  "version": "2.0.0",
  "description": "Nền tảng AI dùng chung AntAdmin — composable chat streaming (client) + proxy Nitro tới AI gateway (server)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.mjs"
    },
    "./prompts": {
      "types": "./dist/prompts/index.d.ts",
      "import": "./dist/prompts/index.mjs"
    },
    "./eval": {
      "types": "./dist/eval/index.d.ts",
      "import": "./dist/eval/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "eval": "tsx scripts/run-evals.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@antadmin/utils": "workspace:*"
  },
  "peerDependencies": {
    "h3": "^1.13.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "h3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antadmin/eslint-config": "workspace:*",
    "@antadmin/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^10.10.0",
    "h3": "^1.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "unbuild": "^3.0.1",
    "vitest": "^3.0.0",
    "vue": "^3.5.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daothanh/antadmin.git",
    "directory": "packages/ai"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
