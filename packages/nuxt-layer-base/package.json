{
  "name": "@antadmin/nuxt-layer-base",
  "version": "1.3.0",
  "description": "Nuxt layer nền của framework AntAdmin — entry point duy nhất team sản phẩm cần extends",
  "license": "MIT",
  "type": "module",
  "main": "./nuxt.config.ts",
  "files": [
    "nuxt.config.ts",
    "antadmin.d.ts",
    "app",
    "server/**",
    "!server/**/*.test.ts"
  ],
  "scripts": {
    "dev:prepare": "nuxi prepare",
    "build": "nuxi prepare",
    "typecheck": "nuxi prepare && vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf .nuxt .turbo"
  },
  "dependencies": {
    "@ant-design-vue/nuxt": "^1.4.6",
    "@nuxt/fonts": "^0.11.4",
    "@antadmin/composables": "workspace:*",
    "@antadmin/theme": "workspace:*",
    "@antadmin/ui": "workspace:*",
    "@antadmin/utils": "workspace:*",
    "ant-design-vue": "4.2.6"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@antadmin/eslint-config": "workspace:*",
    "eslint": "^9.18.0",
    "nuxt": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daothanh/antadmin.git",
    "directory": "packages/nuxt-layer-base"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
