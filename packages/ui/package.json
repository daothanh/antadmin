{
  "name": "@antadmin/ui",
  "version": "1.3.1",
  "description": "Wrapper Ant Design Vue chuẩn hoá (design system AntAdmin)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist .turbo storybook-static"
  },
  "dependencies": {
    "@antadmin/theme": "workspace:*",
    "@antadmin/utils": "workspace:*"
  },
  "peerDependencies": {
    "ant-design-vue": "^4.2.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.5.0",
    "@storybook/vue3": "^8.5.0",
    "@storybook/vue3-vite": "^8.5.0",
    "@antadmin/eslint-config": "workspace:*",
    "@antadmin/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.0.0",
    "@vue/test-utils": "^2.4.6",
    "ant-design-vue": "4.2.6",
    "eslint": "^9.18.0",
    "happy-dom": "^15.11.7",
    "storybook": "^8.5.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daothanh/antadmin.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
