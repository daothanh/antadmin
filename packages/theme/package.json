{
  "name": "@antadmin/theme",
  "version": "1.3.0",
  "description": "Design token + theme antdv (ConfigProvider) + CSS variables cho framework AntAdmin",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./base.css": "./styles/base.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "unbuild",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@antadmin/tsconfig": "workspace:*",
    "typescript": "^5.7.3",
    "unbuild": "^3.0.1"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
