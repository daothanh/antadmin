# Scope @antadmin trỏ GitLab Package Registry ở cấp GROUP (group `antadmin`), không phải
# instance/project endpoint. Group endpoint gộp mọi package @antadmin publish ở các project con
# và cho phép cài bằng 1 read-only token dùng chung — không cần add từng dev làm member.
@antadmin:registry=https://github.com/api/v4/groups/antadmin/-/packages/npm/

# Token xác thực publish/install KHÔNG commit — cấu hình qua env (CI hoặc ~/.npmrc cá nhân):
#   //github.com/api/v4/groups/antadmin/-/packages/npm/:_authToken=${NPM_TOKEN}
# NPM_TOKEN = Group Deploy Token / Group Access Token scope `read_package_registry`
# (đủ để install). Publish trong CI dùng token scope `write_package_registry`.

# pnpm: tự cài peer deps cho DX tốt hơn trong monorepo.
auto-install-peers=true
# Bắt buộc khai báo dependency tường minh (tránh phantom deps).
shamefully-hoist=false
