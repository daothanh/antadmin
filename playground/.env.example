# Khoá mã hoá/ký cookie session (AES-256-GCM). Rỗng ở dev → dùng secret tạm.
# Production BẮT BUỘC đặt (>= 32 ký tự ngẫu nhiên), vd: openssl rand -base64 32
# NUXT_SESSION_SECRET=

# ĐĂNG NHẬP BẰNG FORM (first-party) ─────────────────────────────────────────
# DEV: bỏ qua IAM, tạo session giả để chạy end-to-end.
NUXT_AUTH_MOCK=true

# Khi cắm IAM thật (tắt mock). baseURL bọc cả /iam và /auth; endpoint mặc định
# đã khớp IAM AntAdmin nên thường chỉ cần đặt base URL:
# NUXT_AUTH_BASE_URL=https://api.antadmin.com/cop
# NUXT_AUTH_ENDPOINTS_LOGIN=/auth/auth/login-v1
# NUXT_AUTH_ENDPOINTS_USER_INFO=/iam/user/userInfo
# NUXT_AUTH_ENDPOINTS_CLIENTS=/iam/client/findAll?status=1
# NUXT_AUTH_ENDPOINTS_OTP_SEND=/auth/auth/login/request
# Map field response nếu backend khác cấu trúc:
# NUXT_AUTH_MAPPING_TOKEN=body.tokenData.access_token
# NUXT_AUTH_MAPPING_ROLES=body.roles
# NUXT_AUTH_MAPPING_PERMISSIONS=body.permissions
# Backend gateway mà /api/** proxy tới:
# NUXT_API_PROXY_TARGET=https://gateway.antadmin.vn

# Cấu hình form (client đọc được):
# NUXT_PUBLIC_AUTH_METHODS=google,telegram
# NUXT_PUBLIC_AUTH_SHOW_CLIENT_SELECT=true
# NUXT_PUBLIC_AUTH_DEFAULT_CLIENT_CODE=OAP_OCM

# SSO OIDC (tuỳ chọn — dùng lại util refresh token nếu backend cấp token OIDC):
# NUXT_OIDC_ISSUER=https://id.antadmin.vn/realms/antadmin
# NUXT_OIDC_CLIENT_ID=antadmin-web
# NUXT_OIDC_CLIENT_SECRET=...
